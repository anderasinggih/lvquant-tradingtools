# ── LVQuant environment ───────────────────────────────────────────────────────
# Copy to `.env` and fill in your own values. Never commit the filled file.
#
# Solana JSON-RPC endpoint. Helius is used for this project (see PRD §2); QuickNode or the
# public cluster also work — the provider is auto-detected and credentials are masked in logs.
# Examples:
#   https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
#   https://YOUR_ENDPOINT.solana-mainnet.quiknode.pro/YOUR_TOKEN/
#   https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=

# Bot wallet private key, base58 (exported from Phantom / Solflare / Backpack).
# A JSON byte array from `solana-keygen` is also accepted.
# Use a dedicated, low-balance sub-wallet — never your main wallet.
SOLANA_PRIVATE_KEY=

# Jupiter API key (https://developers.jup.ag/portal). OPTIONAL: the Price/Swap APIs also answer
# unauthenticated at a lower rate limit. Supply it to raise the limit for the live price feed.
JUPITER_API_KEY=

# Historical candles (/api/market/history) come from Binance public Klines — keyless, free, no key
# needed. Set BINANCE_API_BASE only to override the default host (https://data-api.binance.vision).
BINANCE_API_BASE=

# Execution tuning (Fase 4.3). The priority-fee estimator samples recent on-chain fees and bids the
# given percentile of them, capped at MAX_PRIORITY_FEE_LAMPORTS. OPTIONAL — defaults are 75 and 100000.
PRIORITY_FEE_PERCENTILE=
MAX_PRIORITY_FEE_LAMPORTS=
